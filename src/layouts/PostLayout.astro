---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  category: string;
  readTime: string;
  cover?: string;
  description?: string;
  tags?: string[];
}

const { title, date, category, readTime, cover, description, tags } = Astro.props;

// 内容集合里的封面是站点根路径，构建时要补上 /blog 前缀
const coverURL = cover?.startsWith('/') ? `${import.meta.env.BASE_URL}${cover}` : cover;

// 格式化日期（中文）
function formatDateCN(date: Date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}年${month}月${day}日`;
}

// ISO 日期（机器可读）
const isoDate = date.toISOString();
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={coverURL}
  publishDate={isoDate}
  tags={tags}
>
  <div class="post-header">
    <a href={`${import.meta.env.BASE_URL}/`} class="back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      <span class="zh">返回</span>
      <span class="en">Back</span>
    </a>
    <h1>{title}</h1>
    <div class="post-info">
      <time datetime={isoDate} data-date-iso={isoDate}>{formatDateCN(date)}</time>
      <span>·</span>
      <span>{readTime}</span>
      <span>·</span>
      <span>{category}</span>
    </div>
  </div>

  <article class="post-content" aria-label={title}>
    {coverURL && <img src={coverURL} alt={title} class="post-cover">}
    <slot />
  </article>
</BaseLayout>